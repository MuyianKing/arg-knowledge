# App
APP_NAME=enterprise-rag
API_PREFIX=/api/v1
# 前后端分离：允许的前端 origin，逗号分隔；生产禁止 *
CORS_ORIGINS=http://localhost:3000
DEBUG=false
# 本地调试接口 /api/v1/dev/*（LLM 运行时配置、检索调试、上传入库）。
# 仅供内网调试，生产必须为 false。
DEV_TOOLS_ENABLED=false

# Local models (relative to the project root)
# 生成 LLM 不本地部署，通过外部 OpenAI 兼容 API 调用。
BGE_M3_PATH=./models/bge-m3
BGE_RERANKER_PATH=./models/bge-reranker-v2-m3
BM25_MODEL_PATH=./models/bm25

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# External LLM: OpenAI-compatible API
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-...
LLM_MODEL_NAME=deepseek-chat
LLM_MODEL_REVISION=deepseek-chat@2026-xx
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=10
LLM_MAX_MODEL_LEN=8192
LLM_MOCK=false
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
LLM_REDACT_PII=true
LLM_EXTRA_HEADERS={}
PROMPT_VERSION=p1

# Retrieval
TOP_K=5
CANDIDATE_K=50
RRF_K=60
RERANK_THRESHOLD=0.0

# 身份由网关注入：
#   X-Tenant-Id: acme
#   X-Acl: internal,finance
# 引擎不实现登录/API Key/用户体系；缺少这两个头直接 400。
